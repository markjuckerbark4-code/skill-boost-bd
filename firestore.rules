rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isSuperAdmin() {
      return isVerified() && request.auth.token.email == 'markjuckerbark4@gmail.com';
    }

    function isAdmin() {
      return isSuperAdmin() || (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Validation helpers
    function isValidPackage(data) {
      return data.keys().hasAll([
          'title', 'subtitle', 'level', 'duration', 'format',
          'price', 'originalPrice', 'imageUrl', 'features',
          'featured', 'active', 'seatsLabel', 'sortOrder',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'subtitle', 'level', 'duration', 'format',
          'price', 'originalPrice', 'imageUrl', 'features',
          'featured', 'active', 'seatsLabel', 'sortOrder',
          'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && data.subtitle is string && data.subtitle.size() >= 2 && data.subtitle.size() <= 240
        && data.level in ['Beginner', 'Intermediate', 'IELTS & Career', '1-on-1 Coaching']
        && data.duration is string && data.duration.size() >= 1 && data.duration.size() <= 60
        && data.format is string && data.format.size() >= 1 && data.format.size() <= 80
        && data.price is number && data.price >= 0 && data.price <= 1000000
        && data.originalPrice is number && data.originalPrice >= 0 && data.originalPrice <= 1000000
        && data.imageUrl is string && data.imageUrl.size() <= 500
        && data.features is list && data.features.size() <= 12
        && (data.features.size() == 0 || (data.features[0] is string && data.features[0].size() <= 160))
        && data.featured is bool
        && data.active is bool
        && data.seatsLabel is string && data.seatsLabel.size() <= 60
        && data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'orderCode', 'userId', 'packageId', 'packageTitle',
          'studentName', 'studentEmail', 'studentPhone', 'batchPreference',
          'paymentMethod', 'senderNumber', 'trxId', 'couponCode',
          'discountAmount', 'originalAmount', 'finalPrice', 'currency',
          'status', 'adminNote', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'orderCode', 'userId', 'packageId', 'packageTitle',
          'studentName', 'studentEmail', 'studentPhone', 'batchPreference',
          'paymentMethod', 'senderNumber', 'trxId', 'couponCode',
          'discountAmount', 'originalAmount', 'finalPrice', 'currency',
          'status', 'adminNote', 'createdAt', 'updatedAt'
        ])
        && data.orderCode is string && data.orderCode.size() >= 4 && data.orderCode.size() <= 40 && data.orderCode.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.packageId is string && data.packageId.size() >= 1 && data.packageId.size() <= 128
        && data.packageTitle is string && data.packageTitle.size() >= 1 && data.packageTitle.size() <= 120
        && data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 100
        && data.studentEmail is string && data.studentEmail.size() >= 3 && data.studentEmail.size() <= 150
        && data.studentPhone is string && data.studentPhone.size() >= 5 && data.studentPhone.size() <= 40
        && data.batchPreference is string && data.batchPreference.size() >= 1 && data.batchPreference.size() <= 60
        && data.paymentMethod is string && data.paymentMethod.size() >= 1 && data.paymentMethod.size() <= 60
        && data.senderNumber is string && data.senderNumber.size() <= 60
        && data.trxId is string && data.trxId.size() <= 80
        && data.couponCode is string && data.couponCode.size() <= 40
        && data.discountAmount is number && data.discountAmount >= 0 && data.discountAmount <= 1000000
        && data.originalAmount is number && data.originalAmount >= 0 && data.originalAmount <= 1000000
        && data.finalPrice is number && data.finalPrice >= 0 && data.finalPrice <= 1000000
        && data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10
        && data.status in ['pending', 'verified', 'rejected']
        && data.adminNote is string && data.adminNote.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrderLookup(data) {
      return data.keys().hasAll([
          'orderCode', 'orderId', 'packageTitle', 'finalPrice', 'currency',
          'paymentMethod', 'batchPreference', 'status', 'adminNote',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'orderCode', 'orderId', 'packageTitle', 'finalPrice', 'currency',
          'paymentMethod', 'batchPreference', 'status', 'adminNote',
          'createdAt', 'updatedAt'
        ])
        && data.orderCode is string && data.orderCode.size() >= 4 && data.orderCode.size() <= 40 && data.orderCode.matches('^[a-zA-Z0-9_\\-]+$')
        && data.orderId is string && data.orderId.size() >= 1 && data.orderId.size() <= 128
        && data.packageTitle is string && data.packageTitle.size() >= 1 && data.packageTitle.size() <= 120
        && data.finalPrice is number && data.finalPrice >= 0 && data.finalPrice <= 1000000
        && data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10
        && data.paymentMethod is string && data.paymentMethod.size() >= 1 && data.paymentMethod.size() <= 60
        && data.batchPreference is string && data.batchPreference.size() >= 1 && data.batchPreference.size() <= 60
        && data.status in ['pending', 'verified', 'rejected']
        && data.adminNote is string && data.adminNote.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCoupon(data) {
      return data.keys().hasAll(['code', 'discountType', 'discountValue', 'description', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['code', 'discountType', 'discountValue', 'description', 'active', 'createdAt', 'updatedAt'])
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 30 && data.code.matches('^[A-Z0-9_\\-]+$')
        && data.discountType in ['percent', 'fixed']
        && data.discountValue is number && data.discountValue > 0 && data.discountValue <= 1000000
        && data.description is string && data.description.size() <= 150
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'phone', 'email', 'currentLevel', 'goal', 'status', 'createdAt'])
        && data.keys().hasOnly(['name', 'phone', 'email', 'currentLevel', 'goal', 'status', 'createdAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 40
        && data.email is string && data.email.size() <= 150
        && data.currentLevel is string && data.currentLevel.size() <= 60
        && data.goal is string && data.goal.size() <= 400
        && data.status in ['new', 'contacted', 'enrolled']
        && data.createdAt is timestamp;
    }

    function isValidStorefrontSettings(data) {
      return data.keys().hasAll([
          'storeName', 'announcementEnabled', 'announcementText',
          'heroHeadline', 'heroSubheadline', 'enrollmentOpen',
          'currencySymbol', 'currencyCode', 'supportPhone',
          'supportEmail', 'whatsappNumber', 'instructorName',
          'instructorBio', 'testimonials', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'storeName', 'announcementEnabled', 'announcementText',
          'heroHeadline', 'heroSubheadline', 'enrollmentOpen',
          'currencySymbol', 'currencyCode', 'supportPhone',
          'supportEmail', 'whatsappNumber', 'instructorName',
          'instructorBio', 'testimonials', 'updatedAt'
        ])
        && data.storeName is string && data.storeName.size() <= 100
        && data.announcementEnabled is bool
        && data.announcementText is string && data.announcementText.size() <= 200
        && data.heroHeadline is string && data.heroHeadline.size() <= 200
        && data.heroSubheadline is string && data.heroSubheadline.size() <= 400
        && data.enrollmentOpen is bool
        && data.currencySymbol is string && data.currencySymbol.size() <= 10
        && data.currencyCode is string && data.currencyCode.size() <= 10
        && data.supportPhone is string && data.supportPhone.size() <= 40
        && data.supportEmail is string && data.supportEmail.size() <= 150
        && data.whatsappNumber is string && data.whatsappNumber.size() <= 40
        && data.instructorName is string && data.instructorName.size() <= 100
        && data.instructorBio is string && data.instructorBio.size() <= 400
        && data.testimonials is list && data.testimonials.size() <= 10
        && (data.testimonials.size() == 0 || data.testimonials[0] is map)
        && data.updatedAt is timestamp;
    }

    function isValidPaymentSettings(data) {
      return data.keys().hasAll(['methods', 'autoConfirmNote', 'updatedAt'])
        && data.keys().hasOnly(['methods', 'autoConfirmNote', 'updatedAt'])
        && data.methods is list && data.methods.size() <= 10
        && (data.methods.size() == 0 || data.methods[0] is map)
        && data.autoConfirmNote is string && data.autoConfirmNote.size() <= 300
        && data.updatedAt is timestamp;
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'name', 'addedAt'])
        && data.keys().hasOnly(['email', 'name', 'addedAt'])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 150
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.addedAt is timestamp;
    }

    // Packages (Public catalog, Admin managed)
    match /packages/{packageId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidId(packageId) && isValidPackage(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(packageId) && isValidPackage(incoming())
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(packageId);
    }

    // Orders (PII protected: Admin read/update/delete, Student create with atomic lookup)
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(orderId) && isValidOrder(incoming())
        && incoming().status == 'pending'
        && incoming().adminNote == ''
        && incoming().userId == (isSignedIn() ? request.auth.uid : 'guest')
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/orderLookups/$(incoming().orderCode));
      allow update: if isAdmin() && isValidId(orderId) && isValidOrder(incoming())
        && incoming().orderCode == existing().orderCode
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNote', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // Order Lookups (PII-free public tracking by exact orderCode)
    match /orderLookups/{orderCode} {
      allow get: if isValidId(orderCode);
      allow list: if isAdmin();
      allow create: if isValidId(orderCode) && isValidOrderLookup(incoming())
        && incoming().orderCode == orderCode
        && incoming().status == 'pending'
        && incoming().adminNote == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(orderCode) && isValidOrderLookup(incoming())
        && incoming().orderCode == existing().orderCode
        && incoming().orderId == existing().orderId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNote', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(orderCode);
    }

    // Coupons (Exact code lookup by students, full CRUD by admin)
    match /coupons/{couponId} {
      allow get: if isValidId(couponId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(couponId) && isValidCoupon(incoming())
        && incoming().code == couponId
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(couponId) && isValidCoupon(incoming())
        && incoming().code == existing().code
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(couponId);
    }

    // Inquiries (Callback & level assessment requests)
    match /inquiries/{inquiryId} {
      allow get, list, delete: if isAdmin();
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming())
        && incoming().status == 'new' && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(inquiryId) && isValidInquiry(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
    }

    // Settings (Storefront & Payment Gateways)
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && settingId in ['storefront', 'payments'];
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(settingId)
        && ((settingId == 'storefront' && isValidStorefrontSettings(incoming()))
            || (settingId == 'payments' && isValidPaymentSettings(incoming())))
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(settingId);
    }

    // Admins Directory
    match /admins/{uid} {
      allow get: if isValidId(uid) && isVerified() && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidId(uid) && isValidAdmin(incoming());
      allow delete: if isSuperAdmin() && isValidId(uid);
    }
  }
}
